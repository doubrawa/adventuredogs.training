#!/bin/bash
# Laeuft vor jedem Commit. Aktiviert mit:
#
#   git config core.hooksPath tools/hooks
#
# (einmalig je Arbeitskopie; .git/hooks ist nicht versioniert, tools/hooks
# schon — deshalb dieser Umweg.)
#
# Warum es den Hook gibt: GitHub Pages veroeffentlicht jeden Push binnen ein
# bis drei Minuten, und wegen .nojekyll ungefiltert. Zwischen "committet" und
# "steht im Netz" liegt also nichts. Vorher hing jede Kontrolle daran, dass
# jemand daran dachte — die Sitemap neu zu erzeugen, die SEO-Bloecke zu
# setzen, kein Riesenbild einzuchecken. Das hier denkt daran.
#
# Umgehen im Notfall:  git commit --no-verify
set -u

WURZEL="$(git rev-parse --show-toplevel)"
cd "$WURZEL" || exit 1

echo "pre-commit: Website pruefen"

# ── 1. Sitemaps neu erzeugen ──────────────────────────────────────────
# Beide Generatoren sind idempotent. Weichen sie danach von dem ab, was
# gestaget ist, war die Sitemap veraltet — dann nimmt der Hook sie gleich mit
# in den Commit. Bis zum 09.09.2026 brach er stattdessen ab und bat um ein
# `git add`; das kostete bei jeder Textaenderung einen zweiten Anlauf, ohne
# dass je eine andere Entscheidung dabei herausgekommen waere. Beide Dateien
# werden erzeugt und nie von Hand bearbeitet, es geht also nichts verloren.
bash tools/generate-sitemap.sh || {
    echo "  ABBRUCH: generate-sitemap.sh ist gescheitert."
    exit 1
}

# PowerShell gibt es nur auf Windows. Fehlt es, wird gewarnt statt blockiert:
# die Bild-Sitemap ist wichtig, aber kein Grund, einen Commit auf einem
# anderen System unmoeglich zu machen.
if command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -ExecutionPolicy Bypass -File tools/generate-image-sitemap.ps1 || {
        echo "  ABBRUCH: generate-image-sitemap.ps1 ist gescheitert."
        exit 1
    }
else
    echo "  HINWEIS: kein PowerShell gefunden, sitemap-images.xml nicht neu erzeugt."
fi

# Vergleich gegen den Index, nicht gegen den Stand vor dem Lauf: so faellt
# auch der Fall auf, dass jemand die Sitemap vorher von Hand erzeugt und das
# `git add` vergessen hat.
mitgenommen=""
for datei in sitemap.xml sitemap-images.xml; do
    if ! git diff --quiet -- "$datei"; then
        git add "$datei"
        mitgenommen="$mitgenommen $datei"
    fi
done

if [ -n "$mitgenommen" ]; then
    echo "  nicht aktuell, neu erzeugt und in den Commit genommen:$mitgenommen"
fi

# Ausnahme Teil-Commit (`git commit -- pfad`): git baut dafuer einen
# temporaeren Index. Nachgemessen — die Sitemap landet trotzdem im Commit,
# aber der echte Index bleibt auf dem alten Stand, `git status` zeigt sie
# danach als geaendert. Einmal `git add` raeumt das auf.

# ── 2. Website pruefen ────────────────────────────────────────────────
if command -v py >/dev/null 2>&1; then
    PY=py
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v python >/dev/null 2>&1; then
    PY=python
else
    echo "  HINWEIS: kein Python gefunden, check-site.py uebersprungen."
    exit 0
fi

"$PY" tools/check-site.py || {
    echo
    echo "  ABBRUCH: check-site.py meldet Fehler (siehe oben)."
    echo "  Wenn es wirklich so committet werden soll: git commit --no-verify"
    exit 1
}

echo "pre-commit: in Ordnung"
